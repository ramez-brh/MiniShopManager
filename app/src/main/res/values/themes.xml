<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème principal : sans barre d'action (chaque écran a son propre en-tête) -->
    <style name="Theme.App" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/bleu_sbs</item>
        <item name="colorPrimaryVariant">@color/bleu_nuit</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/safran</item>
        <item name="colorSecondaryVariant">@color/safran</item>
        <item name="colorOnSecondary">@color/encre</item>
        <item name="android:colorBackground">@color/fond</item>
        <item name="android:statusBarColor">@color/bleu_nuit</item>
        <item name="android:windowBackground">@color/fond</item>
    </style>

    <!-- Écran de démarrage : fond bleu dès l'ouverture -->
    <style name="Theme.App.Splash" parent="Theme.App">
        <item name="android:windowBackground">@color/bleu_sbs</item>
        <item name="android:statusBarColor">@color/bleu_sbs</item>
    </style>

    <!-- Styles de texte réutilisables -->
    <style name="Texte.Titre" parent="">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/encre</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Texte.Section" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/encre</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Texte.Etiquette" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/gris</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Bouton.Rond" parent="">
        <item name="android:background">@drawable/bg_cercle_blanc</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
